# 客户端必须带 Authorization: Bearer <这个值>。
# 生成一个: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_TOKEN=

# 允许的 Host 头,逗号分隔。反代后面要写对外的域名。
# 裸域名和带端口的要分别列:https 走 443 时 Host 头不带端口,其它端口带。
MCP_ALLOWED_HOSTS=[你的域名],[你的域名]:*,127.0.0.1:*,localhost:*

# 允许的 Origin 头,逗号分隔。留空表示不接受任何跨域来源(纯 MCP 客户端不发 Origin,
# 所以留空通常没问题;浏览器里调才需要填)。
MCP_ALLOWED_ORIGINS=https://[你的域名]/mcp

# uvicorn 监听地址。默认只听本机,由反代转发进来。
MCP_BIND_HOST=127.0.0.1
MCP_BIND_PORT=1949

# 非 sudo 的 shell session 降权到哪个用户。这个账号必须存在,否则启动失败。
# 用 create_agent_user.sh 创建。
MCP_RUN_AS_USER=mcpagent
